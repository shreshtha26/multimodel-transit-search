{
  "version": "clean_reranker_v1",
  "created_date": "2026-08-06",
  "description": "Leakage-audited candidate reranker for the 50-star BLS/ARIMA-TCF pilot. Absolute candidate period fields are excluded because the pilot injection grid used only 2, 5, and 10 day periods.",
  "group_columns": [
    "target_id",
    "quarter",
    "injection_index"
  ],
  "split_unit": "target_id",
  "label_column": "exact_match",
  "secondary_label_column": "harmonic_match",
  "primary_model": "xgboost_classifier",
  "secondary_model": "xgboost_pairwise_ranker",
  "primary_model_reason": "Uses the leakage-audited feature list, performs nearly as well as the pairwise ranker, and produces candidate probabilities needed for false-alarm calibration.",
  "default_cv_splits": 5,
  "default_random_state": 42,
  "feature_columns": [
    "source_detector",
    "selection_group",
    "detector_agreement",
    "detector_count",
    "bls_present",
    "tcf_present",
    "has_bls_candidate",
    "has_tcf_candidate",
    "has_tcf_event_diagnostics",
    "bls_rank",
    "tcf_rank",
    "bls_sde",
    "tcf_score",
    "bls_score_relative_to_rank1",
    "tcf_score_relative_to_rank1",
    "detector_candidate_period_delta_fraction",
    "detector_candidate_harmonic_error_fraction",
    "detector_candidate_best_harmonic_factor",
    "bls_period_delta_to_tcf_best_fraction",
    "tcf_period_delta_to_bls_best_fraction",
    "candidate_to_tcf_best_harmonic_error_fraction",
    "candidate_to_tcf_best_harmonic_factor",
    "candidate_to_bls_best_harmonic_error_fraction",
    "candidate_to_bls_best_harmonic_factor",
    "bls_tcf_rank1_harmonic_error_fraction",
    "bls_tcf_rank1_harmonic_factor",
    "tcf_valid_transit_events",
    "tcf_positive_transit_events",
    "tcf_positive_event_fraction",
    "tcf_median_event_score",
    "tcf_raw_pooled_score",
    "candidate_duration_hours",
    "candidate_depth",
    "noise_quartile",
    "robust_flux_scatter_ppm",
    "gap_fraction",
    "lag_one_flux_acf",
    "six_hour_scatter_proxy_ppm",
    "arima_converged",
    "tcf_global_empirical_p_value",
    "bls_global_empirical_p_value",
    "tcf_regime_empirical_p_value",
    "bls_regime_empirical_p_value",
    "raw_candidate_rank"
  ],
  "forbidden_feature_columns": [
    "candidate_id",
    "target_id",
    "quarter",
    "injection_index",
    "cv_group_id",
    "fold",
    "exact_match",
    "harmonic_match",
    "injected_period_days",
    "injected_epoch_days",
    "injected_depth",
    "injected_duration_hours",
    "epoch_phase_fraction",
    "candidate_period_error_fraction",
    "candidate_harmonic_error_fraction",
    "candidate_best_harmonic_factor",
    "in_transit_observation_count",
    "candidate_period_days",
    "bls_candidate_period_days",
    "tcf_candidate_period_days"
  ],
  "forbidden_feature_prefixes": [
    "injected_"
  ],
  "model_defaults": {
    "logistic_regression": {
      "class_weight": "balanced",
      "max_iter": 2000,
      "solver": "lbfgs"
    },
    "xgboost_classifier": {
      "objective": "binary:logistic",
      "eval_metric": "logloss",
      "n_estimators": 300,
      "max_depth": 3,
      "learning_rate": 0.05,
      "subsample": 0.9,
      "colsample_bytree": 0.9,
      "tree_method": "hist"
    },
    "xgboost_pairwise_ranker": {
      "objective": "rank:pairwise",
      "eval_metric": "ndcg@10",
      "n_estimators": 300,
      "max_depth": 3,
      "learning_rate": 0.05,
      "subsample": 0.9,
      "colsample_bytree": 0.9,
      "tree_method": "hist"
    }
  },
  "validation_snapshot": {
    "source_dataset": "outputs/experiments/multistar_bls_tcf/optimized/metrics/multistar_candidate_reranking_dataset.csv",
    "injection_groups": 900,
    "candidate_rows": 7877,
    "exact_candidate_set_ceiling": 0.8322222222222222,
    "bls_exact_rank1": 0.6344444444444445,
    "tcf_exact_rank1": 0.31333333333333335,
    "xgboost_classifier_exact_recall_at_1": 0.7511111111111111,
    "xgboost_pairwise_ranker_exact_recall_at_1": 0.7555555555555555,
    "xgboost_classifier_improvement_over_bls": 0.11666666666666667,
    "xgboost_classifier_worsened_vs_bls_count": 3,
    "xgboost_classifier_improved_over_bls_count": 108,
    "candidate_generation_misses": 151,
    "xgboost_classifier_ranking_failures": 73,
    "label_permutation_exact_recall_at_1_mean": 0.135,
    "star_bootstrap_xgboost_classifier_exact_recall_at_1_ci_95": [
      0.67,
      0.829
    ]
  }
}
